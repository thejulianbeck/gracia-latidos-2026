{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "deploy-firebase.sh",
      "invitacion-2026/**",
      "resultados-2025/**"
    ],
    "rewrites": [
      {
        "source": "/invitacion-2026",
        "destination": "/_firebase/invitacion-2026.html"
      },
      {
        "source": "/invitacion-2026/",
        "destination": "/_firebase/invitacion-2026.html"
      },
      {
        "source": "/resultados-2025",
        "destination": "/_firebase/resultados-2025.html"
      },
      {
        "source": "/resultados-2025/",
        "destination": "/_firebase/resultados-2025.html"
      }
    ]
  }
}